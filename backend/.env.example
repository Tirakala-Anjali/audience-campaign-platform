# AudienceFlow Backend — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit the .env file to version control.

# ─── Database ───────────────────────────────────────────────────────────────
# IMPORTANT: Use postgresql+psycopg2:// prefix (required for SQLAlchemy 2.1+ with psycopg2-binary)
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg2://postgres:yourpassword@localhost:5432/audienceflow

# ─── Security ───────────────────────────────────────────────────────────────
# Generate a strong random key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# ─── CORS ───────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
# CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ─── Future integrations (leave blank until needed) ─────────────────────────
OPENAI_API_KEY=
SENDGRID_API_KEY=
TWILIO_API_KEY=
